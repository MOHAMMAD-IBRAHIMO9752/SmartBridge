# ==========================================
# SKILLBRIDGE ENVIRONMENT CONFIGURATION
# ==========================================

# Application
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ==========================================
# MYSQL DATABASE
# ==========================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=skillbridge1
DB_USERNAME=your_database_username
DB_PASSWORD=replace_with_your_database_password

# Set through application configuration.
# Do not enable schema recreation in production.
JPA_DDL_AUTO=validate

# ==========================================
# FRONTEND / CORS
# ==========================================
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ==========================================
# ACTUATOR / HEALTH
# ==========================================
ACTUATOR_ENDPOINTS=health,info
SEED_DATA_ENABLED=true
